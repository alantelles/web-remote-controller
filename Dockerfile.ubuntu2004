# ==============================================================================
# Dockerfile para compilação reproduzível no Ubuntu 20.04 (Focal Fossa)
# ==============================================================================
FROM ubuntu:20.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libasound2-dev \
    ca-certificates \
    curl \
    git \
 && rm -rf /var/lib/apt/lists/*

# Instala a versão oficial do Go 1.24.2 (compatível com go.mod)
ENV GO_VERSION=1.24.2
RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"

WORKDIR /app

# Download de dependências
COPY go.mod go.sum ./
RUN go mod download

# Copia código fonte
COPY . .

# Compilação com CGO para ALSA (rtmididrv) e tags netgo para portabilidade
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -tags netgo -ldflags="-s -w" -o 01v96-controller .

# Saída: imagem mínima para extração do binário
FROM scratch
COPY --from=builder /app/01v96-controller /01v96-controller
